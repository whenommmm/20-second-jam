/* LATER: ported from web/later/style.css. All game sizes are world units (540 tall, 960–1280 wide).
   USS has no line-height: single-line text gets a box as tall as the web version's line, with its text centred in it,
   which places the glyphs exactly where CSS does. Positions that need calc(), and every animation, are set from C#.
   USS letter-spacing doesn't come out in pixels (its unit depends on the font), so letter-spaced text carries the web version's
   spacing as rich text instead, <cspace=Npx>, which is exact. */

* { margin: 0; padding: 0; }
Label { white-space: nowrap; }

/* the page: one stage, 540 world px tall and 960–1280 wide, centred; LaterGame sizes it */
#frame { position: absolute; left: 0; top: 0; overflow: hidden; background-color: rgb(253, 220, 172); }
#stage { position: absolute; overflow: hidden; }
#world { position: absolute; left: 0; top: 0; width: 960px; height: 540px; transform-origin: left top;
         -unity-font-definition: url("/Assets/Later/Fonts/Anton SDF.asset"); color: #141414; background-color: rgb(253, 220, 172); }
#play { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
#pills, #pops { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
#score { position: absolute; left: 34px; top: 22px; height: 64px; font-size: 64px; -unity-text-align: middle-left; }
#combo { position: absolute; left: 36px; top: 92px; height: 33px; font-size: 22px; color: #FF3B30; -unity-text-align: middle-left; }

/* the ending's things sit in the middle 960 of the world, as the web version's calc(50% ± …) puts them */
.centre { position: absolute; top: 0; width: 960px; height: 540px; }

/* fullscreen: a labelled button under the start text on the title screen, an icon in the empty top-left corner
   after TIME!, never during play, hidden where the browser can't do it */
#fs { position: absolute; left: 20px; top: 16px; height: 44px; padding: 0 11px; flex-direction: row; align-items: center; opacity: 0.6; }
#fs:hover { opacity: 1; }
#fs .icon { width: 22px; height: 22px; background-image: url("/Assets/Later/UI/Icons/fullscreen.svg"); -unity-background-image-tint-color: #141414; }
#fs Label { display: none; margin-left: 9px; height: 20px; -unity-font-definition: url("/Assets/Later/Fonts/ArchivoBlack SDF.asset"); font-size: 13px; -unity-text-align: middle-left; }
#fs.ontitle { left: 50%; top: 336px; translate: -50% 0; opacity: 0.75; padding: 0 16px; }
#fs.ontitle Label { display: flex; }
#fs.hide { display: none; }

/* phones held upright: ask to rotate (play pauses meanwhile); LaterGame sizes the text like min(34px, 8vw) */
#rotate { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; align-items: center; justify-content: center; padding: 24px; background-color: #141414; }
#rotate.on { display: flex; }
#rotate Label { white-space: normal; -unity-font-definition: url("/Assets/Later/Fonts/Anton SDF.asset"); color: rgb(253, 220, 172); -unity-text-align: middle-center; }

/* dates: paper slips put down by hand */
#dates { position: absolute; right: 40px; top: 26px; width: 150px; height: 80px; }
.slip { position: absolute; right: 0; top: 0; }
.paper { height: 48px; border-width: 3px; border-color: #141414; padding: 5px 12px 7px 12px; font-size: 30px; -unity-text-align: middle-center; background-color: rgb(253, 220, 172); }

/* pills: drawn exactly DEFAULT_PILL_W wide (the widths the fairness tests use), the name centred where the web version puts it */
.pill { position: absolute; left: 0; top: 0; height: 42px; border-radius: 21px; border-width: 2px; border-color: #141414; background-color: #34C759; }
.pill .knob { position: absolute; left: 7px; top: 5px; width: 28px; height: 28px; border-radius: 14px; background-color: rgb(253, 220, 172); }
.pill Label { position: absolute; left: 42px; right: 17px; top: 0; bottom: 0; -unity-font-definition: url("/Assets/Later/Fonts/ArchivoBlack SDF.asset"); font-size: 16px; color: #fff; -unity-text-align: middle-center; }

/* the moon: its centre (the point calls must miss) is the middle of moon + tag, as on the web */
#me { position: absolute; left: 0; top: 0; }
#mewrap { position: absolute; left: 0; top: 0; translate: -50% -50%; align-items: center; }
#mesvg { width: 52px; height: 52px; background-image: url("/Assets/Later/UI/Icons/moon.svg"); -unity-background-image-tint-color: #141414; }
#badge { position: absolute; right: -12px; top: -8px; min-width: 26px; height: 26px; padding: 0 7px; border-radius: 13px; background-color: #FF3B30; color: #fff;
         -unity-font-definition: url("/Assets/Later/Fonts/ArchivoBlack SDF.asset"); font-size: 14px; -unity-text-align: middle-center; }
#badge.zero { visibility: hidden; }
#mewrap .tag { margin-top: 3px; height: 21px; -unity-font-definition: url("/Assets/Later/Fonts/ArchivoBlack SDF.asset"); font-size: 14px; -unity-text-align: middle-center; }

.pop { position: absolute; height: 45px; font-size: 30px; color: #FF3B30; translate: -50% -50%; rotate: -7deg; -unity-text-align: middle-center; }

.ov { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; }
.ov.on { display: flex; }
#title .name { position: absolute; left: 0; right: 0; top: 56px; height: 68px; font-size: 68px; -unity-text-align: middle-center; }
#title .go { position: absolute; left: 0; right: 0; top: 50%; height: 64px; translate: 0 -50%; font-size: 64px; -unity-text-align: middle-center; }
#timeov { font-size: 150px; -unity-text-align: middle-center; }


/* results screen, which shrinks into the phone (the Ending tweens its size, corners and colour, and keeps it centred) */
#card { position: absolute; left: 0; top: 0; width: 960px; height: 540px; overflow: hidden; display: none; background-color: rgb(253, 220, 172); }
#res { position: absolute; left: 0; top: 0; width: 960px; height: 540px; }
#res .lbl { position: absolute; left: 84px; top: 64px; height: 22.5px; -unity-font-definition: url("/Assets/Later/Fonts/ArchivoBlack SDF.asset"); font-size: 15px; -unity-text-align: middle-left; }
#res .num { position: absolute; left: 76px; top: 82px; height: 180px; font-size: 180px; -unity-text-align: middle-left; }
#res .rows { position: absolute; left: 84px; top: 304px; width: 430px; }
#res .row { flex-direction: row; justify-content: space-between; height: 58px; padding: 11px 0 12px 0; border-top-width: 3px; border-color: #141414; opacity: 0; translate: -14px 0; }
#res .row.last { height: 61px; border-bottom-width: 3px; }
#res .row Label { height: 32px; font-size: 32px; -unity-text-align: middle-left; }
#res .stamp { position: absolute; left: 600px; top: 330px; height: 98px; border-width: 6px; border-color: #141414; padding: 8px 18px 12px 18px; font-size: 66px; rotate: -9deg; display: none; -unity-text-align: middle-center; }
#res .doubt { position: absolute; left: 640px; top: 452px; height: 30px; font-size: 30px; rotate: -9deg; opacity: 0; -unity-text-align: middle-left; }

/* the phone: plain and real (Inter stands in for the iPhone's own font) */
#lock { position: absolute; left: 6px; top: 6px; right: 6px; bottom: 6px; border-radius: 37px; overflow: hidden; opacity: 0; background-color: #1d2025; color: #fff;
        -unity-font-definition: url("/Assets/Later/Fonts/Inter-SemiBold SDF.asset"); }
#lock .island { position: absolute; left: 50%; top: 9px; width: 70px; height: 20px; margin-left: -35px; border-radius: 10px; background-color: #000; }
#lock .sbar { flex-shrink: 0; flex-direction: row; justify-content: space-between; align-items: center; height: 38px; padding: 0 22px 0 26px; }
#sbMoon { width: 10px; height: 10px; opacity: 0; background-image: url("/Assets/Later/UI/Icons/moon.svg"); -unity-background-image-tint-color: #fff; }
#lock .sr { flex-direction: row; align-items: center; }
#lock .sig { flex-direction: row; align-items: flex-end; height: 8px; }
#lock .sig VisualElement { width: 2px; margin-left: 1px; border-radius: 0.5px; background-color: #fff; }
#lock .sig .b1 { height: 3px; margin-left: 0; }
#lock .sig .b2 { height: 4.5px; }
#lock .sig .b3 { height: 6px; }
#lock .sig .b4 { height: 8px; opacity: 0.35; }
#lock .g5 { height: 15px; margin-left: 4px; font-size: 10px; -unity-text-align: middle-left; }
#lock .bat { width: 18px; height: 9px; margin-left: 4px; padding: 1px; border-width: 1px; border-color: rgba(255, 255, 255, 0.55); border-radius: 3px; }
#lock .bat .fill { width: 34%; height: 100%; border-radius: 1px; background-color: #fff; }
#lock .date { flex-shrink: 0; margin-top: 8px; height: 18.75px; font-size: 12.5px; opacity: 0.85; -unity-text-align: middle-center; }
#lock .clock { flex-shrink: 0; margin-top: 1px; height: 66px; font-size: 66px; -unity-text-align: middle-center; }
#lock .focus { flex-shrink: 0; flex-direction: row; justify-content: center; height: 24px; margin-top: 10px; }
#focus { flex-direction: row; align-items: center; padding: 0 11px 0 9px; border-radius: 12px; opacity: 0; background-color: rgba(255, 255, 255, 0.15); }
#focusIcon { width: 12px; height: 12px; background-image: url("/Assets/Later/UI/Icons/moon.svg"); -unity-background-image-tint-color: #fff; }
#focusText { margin-left: 5px; height: 16.5px; font-size: 11px; -unity-text-align: middle-left; }
#lock .sil { flex-shrink: 0; margin-top: 7px; height: 14.25px; font-size: 9.5px; opacity: 0; -unity-text-align: middle-center; }
#lock .list { position: absolute; left: 9px; right: 9px; bottom: 62px; }
#group { margin-top: 6px; opacity: 0; }

/* a notification card (.n): icon, then title and time, then text */
.n { flex-direction: row; align-items: flex-start; padding: 8px 10px 9px 8px; border-radius: 15px; background-color: rgba(255, 255, 255, 0.13); }
.n .ic { flex-shrink: 0; width: 22px; height: 22px; border-radius: 6px; align-items: center; justify-content: center; background-color: #34C759; }
.n .ic .icon { width: 13px; height: 13px; }
.n .body { flex-grow: 1; flex-shrink: 1; margin-left: 8px; }
.n .tt { flex-direction: row; justify-content: space-between; align-items: flex-end; }
.n .tt .b { flex-direction: row; }
.n .tt .b Label { height: 14.52px; font-size: 11px; -unity-text-align: middle-left; }
#gword { margin-left: 3px; }
.n .when { flex-shrink: 0; margin-left: 6px; height: 11.88px; font-size: 9px; opacity: 0.55; -unity-text-align: middle-right; }
.n .text { white-space: normal; font-size: 10.5px; }
.n .sub { height: 12.54px; margin-bottom: 1px; font-size: 9.5px; opacity: 0.6; -unity-text-align: middle-left; }
.n .sub.more { margin-top: 1px; margin-bottom: 0; }
.n .vm { max-height: 39px; overflow: hidden; text-overflow: ellipsis; white-space: normal; font-size: 10px; }
.n .vm.clamp2 { max-height: 26px; }
.n.pending { opacity: 0; }
/* the Messages card sits on the rest of the thread: two slivers peek out under it */
.n.stacked { margin-bottom: 10px; }
.n .peek1, .n .peek2 { position: absolute; top: 100%; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; }
.n .peek1 { left: 3px; right: 3px; height: 3px; background-color: rgba(255, 255, 255, 0.08); }
.n .peek2 { left: 6px; right: 6px; height: 5px; background-color: rgba(255, 255, 255, 0.05); }
#group .peek { height: 7px; margin: 0 10px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; background-color: rgba(255, 255, 255, 0.08); }
#group .peek.p2 { margin: 0 20px; background-color: rgba(255, 255, 255, 0.05); }
#lock .ctl { position: absolute; bottom: 20px; width: 34px; height: 34px; border-radius: 17px; align-items: center; justify-content: center; background-color: rgba(255, 255, 255, 0.14); }
#lock .ctl .icon { width: 15px; height: 15px; }
#lock .ctl.cl { left: 26px; }
#lock .ctl.cr { right: 26px; }
#lock .home { position: absolute; left: 50%; bottom: 7px; width: 90px; height: 4px; margin-left: -45px; border-radius: 2px; background-color: rgba(255, 255, 255, 0.85); }
/* small screens (landscape phones): the phone's text a touch larger so it stays readable when the world is scaled down */
.small .n .text { font-size: 11.6px; }
.small .n .tt .b Label { height: 15.84px; font-size: 12px; }
.small .n .when { height: 13.2px; font-size: 10px; }
.small .n .sub { height: 13.2px; font-size: 10px; }
.small .n .vm { max-height: 42.9px; font-size: 11px; }
.small .n .vm.clamp2 { max-height: 28.6px; }
.small #lock .sil { height: 15.75px; font-size: 10.5px; }

#sheet { position: absolute; left: 0; right: 0; top: 38px; bottom: 0; display: none; padding: 4px 9px 0 9px; background-color: #1d2025; }
#sheet.on { display: flex; }
#sheet .sh { flex-shrink: 0; flex-direction: row; justify-content: space-between; align-items: center; padding: 4px 2px 10px 2px; }
#sheet .heading { height: 25.5px; -unity-font-definition: url("/Assets/Later/Fonts/Inter-Bold SDF.asset"); font-size: 17px; -unity-text-align: middle-left; }
/* a bigger tap area than it looks */
#sheetClose { padding: 14px 10px; margin: -14px -10px; }
#sheetClose Label { height: 23.75px; padding: 5px 10px; border-radius: 11px; font-size: 10.5px; background-color: rgba(255, 255, 255, 0.15); -unity-text-align: middle-center; }
/* like a real phone: the list runs to the bottom edge, with room at its end so the last message clears the rounded corners */
#sheetList { flex-grow: 1; flex-shrink: 1; min-height: 0; }
#sheetList > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding-bottom: 30px; }

/* her words, read out line by line beside the phone */
#caption { position: absolute; left: 642px; top: 84px; width: 285px; display: none; color: #141414; }
#caption.on { display: flex; }
#caption .who { height: 16.5px; margin-bottom: 12px; -unity-font-definition: url("/Assets/Later/Fonts/ArchivoBlack SDF.asset"); font-size: 11px; opacity: 0.55; -unity-text-align: middle-left; }
#caption .line { margin-bottom: 4px; white-space: normal; -unity-font-definition: url("/Assets/Later/Fonts/Newsreader-Italic SDF.asset"); font-size: 19px; }

/* TURN BACK TIME, and what it answers */
#again { position: absolute; right: 40px; bottom: 26px; max-width: 290px; display: none; align-items: flex-end; }
#again.on { display: flex; }
#again .loud { height: 31.6px; border-bottom-width: 3px; border-color: #141414; font-size: 26px; -unity-text-align: middle-right; }
#again.tried .loud { height: auto; border-color: rgba(20, 20, 20, 0); white-space: normal; -unity-text-align: upper-right; }
#again .soft { margin-top: 8px; white-space: normal; -unity-font-definition: url("/Assets/Later/Fonts/Newsreader-Italic SDF.asset"); font-size: 21px; -unity-text-align: upper-right; }
#again .lesson { margin-top: 14px; white-space: normal; font-size: 19px; -unity-text-align: upper-right; }
#restartTap { position: absolute; left: 26px; bottom: 18px; padding: 16px 14px; display: none; }
#restartTap.on { display: flex; }
#restart { height: 22px; padding-bottom: 2px; border-bottom-width: 2px; border-color: #141414; -unity-font-definition: url("/Assets/Later/Fonts/ArchivoBlack SDF.asset"); font-size: 12px; -unity-text-align: middle-left; }

.icon.handset { background-image: url("/Assets/Later/UI/Icons/handset.svg"); }
.icon.bubble { background-image: url("/Assets/Later/UI/Icons/bubble.svg"); }
.icon.flashlight { background-image: url("/Assets/Later/UI/Icons/flashlight.svg"); }
.icon.camera { background-image: url("/Assets/Later/UI/Icons/camera.svg"); }

/* things that fly from the game into the phone */
#fly { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.flyer { position: absolute; align-items: center; justify-content: center; }
.flyer.moon { background-image: url("/Assets/Later/UI/Icons/moon.svg"); -unity-background-image-tint-color: #141414; }
.flyer.pillbg { opacity: 0; border-radius: 12px; background-color: rgba(255, 255, 255, 0.15); }
.flyer.badge { border-radius: 999px; background-color: #FF3B30; }
.flyer Label { position: absolute; left: 50%; top: 50%; translate: -50% -50%; -unity-text-align: middle-center; }
.flyer .was { -unity-font-definition: url("/Assets/Later/Fonts/ArchivoBlack SDF.asset"); color: #141414; }
.flyer .now { -unity-font-definition: url("/Assets/Later/Fonts/Inter-SemiBold SDF.asset"); color: #fff; opacity: 0; }
.flyer.badge Label { -unity-font-definition: url("/Assets/Later/Fonts/ArchivoBlack SDF.asset"); color: #fff; }
