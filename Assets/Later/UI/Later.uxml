<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Ported from web/later/index.html. Element order is the z-order (the web version's z-indexes); names are its ids. -->
    <Style src="Later.uss" />
    <ui:VisualElement name="frame">
        <ui:VisualElement name="stage">
            <ui:VisualElement name="world">
                <ui:VisualElement name="play" picking-mode="Ignore">
                    <ui:VisualElement name="pills" picking-mode="Ignore" />
                    <ui:Label name="score" text="0" picking-mode="Ignore" />
                    <ui:Label name="combo" picking-mode="Ignore" />
                    <ui:VisualElement name="dates" picking-mode="Ignore" />
                    <ui:VisualElement name="pops" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="centre" class="centre" picking-mode="Ignore">
                    <ui:VisualElement name="card" />
                    <ui:VisualElement name="caption" />
                </ui:VisualElement>
                <ui:VisualElement name="me" picking-mode="Ignore">
                    <ui:VisualElement name="mewrap" picking-mode="Ignore">
                        <ui:VisualElement name="mesvg" picking-mode="Ignore" />
                        <ui:Label name="badge" text="0" class="zero" picking-mode="Ignore" />
                        <ui:Label text="&lt;cspace=1.5px&gt;LATER&lt;/cspace&gt;" class="tag" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="title" class="ov on">
                    <ui:Label text="&lt;cspace=4px&gt;LATER&lt;/cspace&gt;" class="name" />
                    <ui:Label name="go" text="CLICK TO START" class="go" />
                </ui:VisualElement>
                <ui:Label name="timeov" text="TIME!" class="ov" />
                <ui:VisualElement name="centre-top" class="centre" picking-mode="Ignore">
                    <ui:VisualElement name="again" />
                    <ui:Label name="restart" text="PLAY AGAIN" />
                </ui:VisualElement>
                <ui:VisualElement name="fly" picking-mode="Ignore" />
                <ui:VisualElement name="fs">
                    <ui:VisualElement class="icon" picking-mode="Ignore" />
                    <ui:Label text="&lt;cspace=2px&gt;FULLSCREEN&lt;/cspace&gt;" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="rotate">
            <ui:Label text="ROTATE YOUR DEVICE" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
